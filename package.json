{
    "name": "rock-buddy",
    "version": "1.12.0-beta1",
    "description": "Rock Buddy",
    "main": "./src/main.js",
    "scripts": {
        "build": "python pre_build.py && node tooling/clean-renderer.cjs && tsc && webpack --mode=development",
        "start": "npm run build && electron .",
        "dev": "npm run build && electron . http://raspberrypi:8080",
        "release": "git clean -dfX && git submodule foreach --recursive git clean -dfX && npm install && npm run build && npm run build:renderer:production && electron-builder",
        "test": "tsc --noEmit -p tests/tsconfig.json && node --test --test-concurrency=2 --test-timeout=30000 tests/*.test.js && tsx --tsconfig tests/tsconfig.json --test --test-concurrency=2 --test-timeout=30000 tests/ui/*.test.tsx",
        "start:staging": "npm run build && electron . --backend=staging",
        "start:local": "npm run build && electron . --backend=local",
        "package:desktop": "npm run build:renderer:production && electron-builder --config electron-builder.release.cjs --win nsis --x64 --publish never",
        "build:renderer": "node tooling/clean-renderer.cjs && tsc && webpack --mode=development",
        "start:beta": "npm run build && electron . --backend=beta",
        "build:renderer:production": "node tooling/clean-renderer.cjs && tsc && webpack --mode=production"
    },
    "author": "TNTMusicStudios",
    "license": "MIT",
    "dependencies": {
        "@tanstack/react-query": "5.104.2",
        "aes-js": "^3.1.2",
        "async-mutex": "^0.5.0",
        "electron-is-dev": "^3.0.1",
        "electron-store": "^11.0.2",
        "electron-updater": "6.8.9",
        "glob": "^11.0.3",
        "open-file-explorer": "^1.0.2",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-router-dom": "^7.18.4",
        "semver": "^7.7.3"
    },
    "devDependencies": {
        "@testing-library/react": "16.3.3",
        "@types/jsdom": "^30.0.0",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "electron": "^39.0.0",
        "electron-builder": "^26.0.12",
        "js-yaml": "5.4.3",
        "jsdom": "30.1.2",
        "msbuild": "^1.2.0",
        "tsx": "4.23.15",
        "typescript": "^5.9.3",
        "webpack": "^5.102.1",
        "webpack-cli": "^6.0.1"
    },
    "build": {
        "icon": "images/icon-256x256",
        "target": "nsis",
        "nsis": {
            "oneClick": true,
            "perMachine": false
        },
        "extraFiles": [
            {
                "from": "RockSniffer/RockSniffer/bin/x64/Release/net8.0",
                "to": "RockSniffer"
            },
            {
                "from": "rock-buddy-addons",
                "to": "addons/rock-buddy"
            },
            {
                "from": "RockSniffer/addons",
                "to": "addons/RockSniffer"
            }
        ],
        "directories": {
            "output": "release"
        }
    }
}
